# Drizzle
DATABASE_URL=local.db

# Public (exposed to the browser)
# If unset, the app will use /digimon-card-game.mp3 from the static/ folder
PUBLIC_BG_MUSIC_URL=/digimon-card-game.mp3

# Autoplay is often blocked unless muted (or after a user gesture).
# Recommended: keep these off, and let users click Play.
PUBLIC_BG_MUSIC_AUTOPLAY=false
PUBLIC_BG_MUSIC_AUTOPLAY_MUTED=true
